{
  "tests": [
    {
      "name": "Service healthcheck",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Chats require admin key",
      "method": "GET",
      "path": "/?action=chats",
      "expectedStatus": 401
    },
    {
      "name": "Login rejects wrong password",
      "method": "POST",
      "path": "/?action=login",
      "body": {"action": "login", "password": "wrong-password-test"},
      "expectedStatus": 401
    },
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    }
  ]
}